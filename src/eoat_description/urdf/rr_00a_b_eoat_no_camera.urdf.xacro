<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="rr_00a_b_eoat_no_camera_visual_mesh" value="package://eoat_description/meshes/rr_00a_b_eoat_no_camera_visual_roller52.stl"/>
  <!-- Keep the roller out of the bracket mesh.  MoveIt may then allow contact
       for the roller link only without making the whole EOAT transparent. -->
  <xacro:property name="rr_00a_b_eoat_no_camera_collision_mesh" value="package://eoat_description/meshes/rr_00a_b_eoat_no_camera_collision_support_only.stl"/>
  <xacro:property name="rr_00a_b_eoat_no_camera_roller_length" value="0.175"/>
  <xacro:property name="rr_00a_b_eoat_no_camera_roller_radius" value="0.026"/>

  <xacro:property name="rr_00a_b_eoat_no_camera_size_x" value="0.220"/>
  <xacro:property name="rr_00a_b_eoat_no_camera_size_y" value="0.113"/>
  <xacro:property name="rr_00a_b_eoat_no_camera_size_z" value="0.2305"/>

  <xacro:macro name="rr_00a_b_eoat_no_camera" params="parent prefix xyz rpy mass">
    <link name="${prefix}link">
      <visual name="${prefix}visual">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${rr_00a_b_eoat_no_camera_visual_mesh}"/>
        </geometry>
        <material name="${prefix}warm_gray">
          <color rgba="0.72 0.70 0.66 1.0"/>
        </material>
      </visual>

      <collision name="${prefix}collision">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${rr_00a_b_eoat_no_camera_collision_mesh}"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia
          ixx="${mass * (rr_00a_b_eoat_no_camera_size_y * rr_00a_b_eoat_no_camera_size_y + rr_00a_b_eoat_no_camera_size_z * rr_00a_b_eoat_no_camera_size_z) / 12.0}"
          ixy="0"
          ixz="0"
          iyy="${mass * (rr_00a_b_eoat_no_camera_size_x * rr_00a_b_eoat_no_camera_size_x + rr_00a_b_eoat_no_camera_size_z * rr_00a_b_eoat_no_camera_size_z) / 12.0}"
          iyz="0"
          izz="${mass * (rr_00a_b_eoat_no_camera_size_x * rr_00a_b_eoat_no_camera_size_x + rr_00a_b_eoat_no_camera_size_y * rr_00a_b_eoat_no_camera_size_y) / 12.0}"/>
      </inertial>
    </link>

    <joint name="${prefix}fixed_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <!-- The measured roller component is centred at (0, -18, 76.75) mm in
         the EOAT CAD frame and its axis is local +X.  The combined visual
         remains on the parent link; this child carries collision only. -->
    <link name="${prefix}roller_contact_link">
      <collision name="${prefix}roller_contact_collision">
        <origin xyz="0 -0.018 0.07675" rpy="0 1.5707963267948966 0"/>
        <geometry>
          <cylinder
            length="${rr_00a_b_eoat_no_camera_roller_length}"
            radius="${rr_00a_b_eoat_no_camera_roller_radius}"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}roller_contact_fixed_joint" type="fixed">
      <parent link="${prefix}link"/>
      <child link="${prefix}roller_contact_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
  </xacro:macro>
</robot>
