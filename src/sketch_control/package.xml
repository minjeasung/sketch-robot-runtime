<?xml version="1.0"?>
<package format="3">
  <name>sketch_control</name>
  <version>0.1.0</version>
  <description>Sketch-based robot control for UR10 in Isaac Sim</description>
  <maintainer email="minjea@todo.com">minjea</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>rcl_interfaces</depend>
  <depend>action_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>controller_manager_msgs</depend>
  <depend>ament_index_python</depend>
  <depend>moveit_msgs</depend>
  <depend>shape_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>rbpodo_painting_control</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>rbpodo_bringup</exec_depend>
  <exec_depend>rbpodo_moveit_config</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>rosbridge_server</exec_depend>
  <exec_depend>rbpodo_msgs</exec_depend>
  <exec_depend>eoat_description</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>
