# Optional machine-local settings: copy to config/sketch_runtime.env (gitignored).
SKETCH_SUPERVISOR_HOST=127.0.0.1
SKETCH_SUPERVISOR_PORT=8081
# Required when HOST=0.0.0.0 for access from another PC. Do not commit tokens.
# SKETCH_SUPERVISOR_API_TOKEN=generate-a-private-token
SKETCH_ROBOT_IP=10.0.2.7
# Supported arms: rb10_1300e_u (RB10-1300E), rb20_1900es (RB20-1900ES)
SKETCH_MODEL_ID=rb10_1300e_u
SKETCH_PROFILE=dry_run
# Camera ownership stays with Michelo. IDs/serials come from its camera list.
SKETCH_CAMERA_BACKEND=outpost
SKETCH_OUTPOST_HTTP=http://127.0.0.1:8100
SKETCH_OUTPOST_ZED_HW_ID=
SKETCH_OUTPOST_ZED_SERIAL=
SKETCH_OUTPOST_D405_HW_ID=
SKETCH_OUTPOST_D405_SERIAL=
SKETCH_LAUNCH_ZED_DRIVER=false
SKETCH_LAUNCH_D405_DRIVER=false
# Added-button console; upstream 8100 and its files stay unchanged.
SKETCH_MICHELO_HOST=127.0.0.1
SKETCH_MICHELO_PORT=8101
# For LAN use set both HOST values to 0.0.0.0 and set both private tokens.
# SKETCH_MICHELO_TOKEN=private-password-for-basic-user-sketch
# Default link uses the browser's hostname and SKETCH_SUPERVISOR_PORT.
# SKETCH_PUBLIC_URL=http://robot-host:8081/sketch/
# ROS_DOMAIN_ID=0
# SKETCH_LAUNCH_ZED_DRIVER=false  # reuse an already running ZED driver
# SKETCH_LAUNCH_D405_DRIVER=false
# SKETCH_LAUNCH_RVIZ=true
