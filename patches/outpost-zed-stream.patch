+"""Local network-input extension of the delivered Michelo ZED adapter.
+
+Only device opening changes. Frame conversion, capture settings, lifecycle,
+depth normalization and streaming remain in michelo-library; HTTP/WS/IPC remain
+in the official Outpost daemon. This is a local extension, not an upstream release.
+The protected ZED hooks/handle layout are pinned to michelo-library 0.87.0.
+"""
+from __future__ import annotations
+
+import time
+from importlib.metadata import version
+from ipaddress import IPv4Address
+from urllib.parse import urlsplit
+
+from michelo_library.hw_interface.vision.zed.adapter import (
+    CameraConnectionError,
+    CameraDisconnected,
+    CaptureError,
+    ZedCameraAdapter,
+    ZedDeviceHandle,
+    require_pyzed,
+)
+
+
+def stream_address(identity: str) -> tuple[str, int]:
+    """Explicit numeric IPv4 URI; never interpret a bad stream URI as USB."""
+    uri = urlsplit(identity)
+    if (uri.scheme != "stream" or uri.username is not None or uri.password is not None
+            or uri.path or uri.query or uri.fragment or uri.port is None):
+        raise ValueError("ZED stream camera_id must be stream://IPv4:port")
+    host = str(IPv4Address(uri.hostname or ""))
+    if not 1 <= uri.port <= 65535:
+        raise ValueError("ZED stream port must be in 1..65535")
+    return host, uri.port
+
+
+class ZedStreamAdapter(ZedCameraAdapter):
+    """Use SDK set_from_stream instead of ZedSession's USB serial selection."""
+
+    def __init__(self, cfg: dict):
+        if version("michelo-library") != "0.87.0":
+            raise RuntimeError("ZED stream extension requires michelo-library 0.87.0; revalidate before upgrading")
+        identity = str(cfg["camera_id"])
+        self.stream_host, self.stream_port = stream_address(identity)
+        if cfg.get("manufacturer") not in (None, "stereolabs"):
+            raise ValueError("ZED stream manufacturer must be stereolabs")
+        super().__init__(hw_id=cfg["id"], serial=identity, config=cfg.get("config"))
+        self._last_stream_timestamp_ns = 0
+
+    def _do_connect_blocking(self) -> None:
+        sl = require_pyzed()
+        params = self._build_init_params(sl)
+        params.set_from_stream(self.stream_host, self.stream_port)
+        camera = sl.Camera()
+        # Retain ownership even if open or cleanup raises, so the base lifecycle
+        # can retry cleanup. The serial here is bookkeeping, never SDK selection.
+        self._handle = ZedDeviceHandle(serial=0, camera=camera)
+        try:
+            status = camera.open(params)
+            if status != sl.ERROR_CODE.SUCCESS:
+                raise CameraConnectionError(f"ZED stream {self.camera_id}: SDK open failed: {status}")
+            self._handle.serial = int(camera.get_camera_information().serial_number)
+            self._apply_gain_blocking(sl, self._handle)
+            self._fetch_cancel.clear()
+            self._last_stream_timestamp_ns = 0
+        except BaseException:
+            self._do_disconnect_blocking()
+            raise
+
+    def _do_disconnect_blocking(self) -> None:
+        self._fetch_cancel.set()
+        if self._handle is not None:
+            self._handle.camera.close()
+            self._handle._open = False
+            self._handle = None
+
+    def _grab_until(self, sl, handle, runtime, timeout_s):
+        # A paused source must not look fresh just because the library stamps a
+        # returned FramePacket with software wall time. Do not replace the wire
+        # clock with Isaac's wall-anchored simulation clock; compare it only for
+        # progression, and retain the library's documented software timestamp.
+        deadline = time.monotonic() + timeout_s
+        while True:
+            remaining = deadline - time.monotonic()
+            if remaining <= 0:
+                raise CaptureError("ZED stream timed out waiting for a new frame")
+            super()._grab_until(sl, handle, runtime, remaining)
+            stamp = int(handle.camera.get_timestamp(sl.TIME_REFERENCE.IMAGE).get_nanoseconds())
+            if stamp <= 0 or stamp < self._last_stream_timestamp_ns:
+                raise CameraDisconnected("ZED stream source clock reset; reconnect required")
+            if stamp > self._last_stream_timestamp_ns:
+                self._last_stream_timestamp_ns = stamp
+                return
+            time.sleep(min(.005, remaining))
